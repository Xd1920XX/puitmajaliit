rules_version = '2';

// All reads/writes go through Cloud Functions (`api` HTTPS function) using
// Firebase Admin SDK, which bypasses these rules. Direct client access is
// denied — launch token verification and API-key auth live in the Functions
// layer, not in Firestore rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
