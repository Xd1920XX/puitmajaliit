# Vite production env — commititakse repo-sse (ainult avalikud väärtused).
# Netlify build loeb seda automaatselt. Override Netlify UI-s kui vaja.

# Game API — Netlify redirect /api/** → Cloud Functions (vt netlify.toml).
# Same-origin → brauser ei pea CORS-i tegema.
VITE_API_BASE=/api

# Mängu ülesanne (üks MVP-s). Firestore kirje tasks/vm-001.
VITE_TASK_ID=vm-001

# Vaikimisi tagasilink Academy'sse (kui launch JWT return_url puudub).
# Asenda päris Academy URL-iga kui teada.
VITE_ACADEMY_RETURN_URL=https://academy.woodhouse.ee/mang/projekteeri
