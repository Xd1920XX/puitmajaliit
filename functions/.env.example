# Functions env — kohalik emulaator kasutab seda, kui `.env.local` olemas.
# Produktsioonis kasuta `firebase functions:secrets:set <NAME>` käske.

# Academy launch token allkirjastamise saladus (HS256). Peab ühtima Academy
# backendi omaga. 32+ baiti juhuslikku.
ACADEMY_JWT_SECRET=change-me-dev-only

# Server-to-server API võti, mida Academy backend kasutab Bearer päistes.
ACADEMY_API_KEY=change-me-dev-only
