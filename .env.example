# Virtuaalne mudeldaja — frontend env (Vite loeb `VITE_*` prefiksiga).
# Kopeeri `.env.local`-i ja täida väärtused.

# Game API baas. Kui kasutad Firebase Hosting rewrite'i → "/api".
# Kui otse funktsioonile → "https://europe-west1-<project>.cloudfunctions.net/api"
VITE_API_BASE=/api

# Mängu task_id (üks ülesanne MVP-s). Serveri kirje tasks/{VITE_TASK_ID}.
VITE_TASK_ID=vm-001

# Vaikimisi tagasilink Academy'sse (kui launch token return_url puudub).
VITE_ACADEMY_RETURN_URL=https://academy.woodhouse.ee/mang/projekteeri
